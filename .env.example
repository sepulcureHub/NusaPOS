# ─────────────────────────────────────────────
# NusaPOS — template environment
# Salin jadi .env.local lalu isi nilainya.
# .env.local sudah di-.gitignore — JANGAN commit key asli.
# ─────────────────────────────────────────────

# ── Google Maps (opsional) ───────────────────
# Tanpa key ini, peta tetap Google Maps (mode embed publik) dan geocoding
# otomatis fallback ke Nominatim/Photon + basis lokasi offline.

# Dipakai di browser untuk Google Maps Embed API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dipakai di server untuk Google Geocoding API (boleh diisi key yang sama)
GOOGLE_MAPS_API_KEY=

# ── Supabase (Tahap 2 — backend) ─────────────
# Ambil dari Project Settings → API

# URL project (aman di browser)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) — aman di browser, dibatasi RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — SERVER ONLY, bypass RLS.
# JANGAN kasih prefix NEXT_PUBLIC_, JANGAN dipakai di kode klien.
SUPABASE_SECRET_KEY=

# ── Mode data ────────────────────────────────
# demo = localStorage (prototipe, default)
# live = Supabase (aktifkan setelah irisan jalur uang siap)
NEXT_PUBLIC_DATA_MODE=demo