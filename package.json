{
  "name": "nusapos",
  "version": "1.1.3",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:smart": "node scripts/build.mjs",
    "build:safe": "node scripts/build.mjs --workers=1 --heap=2048 --no-cache",
    "build:webpack": "node scripts/build.mjs --workers=1 --heap=2048 --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:safe": "node scripts/verify-lowmem.mjs --only=lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck",
    "verify": "npm run check && npm run test && npm run build",
    "verify:safe": "node scripts/verify-lowmem.mjs",
    "doctor": "node scripts/doctor.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
